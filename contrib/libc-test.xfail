# libc-test: tests that pass natively but fail with box64, see contrib/libc-test.sh
# <guest> <host> <test> [flaky], <guest> and <host> are globs on the guest's libc
# (glibc, musl, bionic) and on the host tag (<distro>-<libc>-<toolchain>-<arch>),
# a flaky test is not reported when it passes

# aarch64 bionic libm raises other fp exceptions than x86_64's (Intel code)
bionic termux-* src/math/asin.exe
bionic termux-* src/math/atan.exe
bionic termux-* src/math/cosh.exe
bionic termux-* src/math/exp.exe
bionic termux-* src/math/expm1f.exe
bionic termux-* src/math/sin.exe
bionic termux-* src/math/sinh.exe
bionic termux-* src/math/tan.exe
bionic termux-* src/math/tanh.exe

# x87 long double is computed in double precision, by design (and the *l
# functions run as their double version). [!b]*: glibc and musl, not bionic,
# whose x86_64 long double is binary128, passed as is
[!b]* * src/functional/strtold.exe
[!b]* * src/functional/strtold-static.exe
[!b]* * src/math/acosl.exe
[!b]* * src/math/asinhl.exe
[!b]* * src/math/asinl.exe
[!b]* * src/math/atan2l.exe
[!b]* * src/math/atanhl.exe
[!b]* * src/math/atanl.exe
[!b]* * src/math/cbrtl.exe
[!b]* * src/math/coshl.exe
[!b]* * src/math/cosl.exe
[!b]* * src/math/erfcl.exe
[!b]* * src/math/erfl.exe
[!b]* * src/math/exp10l.exe
[!b]* * src/math/exp2l.exe
[!b]* * src/math/expl.exe
[!b]* * src/math/expm1l.exe
[!b]* * src/math/fdiml.exe
[!b]* * src/math/fmal.exe
[!b]* * src/math/fmodl.exe
# (fpclassify passes with the interpreter: *[!p] is not -interp)
glibc  *[!p] src/math/fpclassify.exe
[!b]* * src/math/hypotl.exe
[!b]* * src/math/ilogbl.exe
[!b]* * src/math/isless.exe
[!b]* * src/math/lgammal.exe
[!b]* * src/math/lgammal_r.exe
[!b]* * src/math/log10l.exe
[!b]* * src/math/log2l.exe
[!b]* * src/math/logl.exe
[!b]* * src/math/modfl.exe
[!b]* * src/math/nextafterl.exe
[!b]* * src/math/nexttoward.exe
[!b]* * src/math/nexttowardf.exe
[!b]* * src/math/nexttowardl.exe
[!b]* * src/math/pow10l.exe
[!b]* * src/math/powl.exe
[!b]* * src/math/remainderl.exe
[!b]* * src/math/remquol.exe
[!b]* * src/math/scalblnl.exe
[!b]* * src/math/scalbnl.exe
[!b]* * src/math/sincosl.exe
[!b]* * src/math/sinhl.exe
[!b]* * src/math/sinl.exe
[!b]* * src/math/sqrtl.exe
[!b]* * src/math/tanhl.exe
[!b]* * src/math/tanl.exe
[!b]* * src/math/tgammal.exe
[!b]* * src/regression/fpclassify-invalid-ld80.exe
[!b]* * src/regression/fpclassify-invalid-ld80-static.exe

# the exact long double operations run in double precision as well: the
# dynarec compares their results in double, the interpreter with all 80 bits
[!b]*  *-interp src/math/copysignl.exe
[!b]*  *-interp src/math/fabsl.exe
[!b]*  *-interp src/math/frexpl.exe
[!b]*  *-interp src/math/ldexpl.exe
musl   *-interp src/math/fmaxl.exe
musl   *-interp src/math/fminl.exe

# filling the memory takes minutes with the interpreter
glibc  *-interp src/regression/malloc-oom-static.exe
glibc  *-interp src/regression/pthread_create-oom-static.exe
glibc  *-interp src/regression/setenv-oom-static.exe

# musl's own printf, scanf and strtod compute in x87 long double
musl   * src/functional/snprintf-static.exe
musl   * src/functional/sscanf-static.exe
musl   * src/functional/strtod-static.exe
musl   * src/functional/strtod_long-static.exe
musl   * src/functional/strtod_simple-static.exe
musl   * src/functional/strtof-static.exe
musl   * src/functional/swprintf-static.exe
musl   * src/regression/printf-1e9-oob-static.exe

# a musl guest on a glibc host runs glibc's code, which behaves differently
musl   *-glibc-* src/functional/clocale_mbfuncs.exe
musl   *-glibc-* src/functional/crypt.exe
musl   *-glibc-* src/functional/fnmatch.exe
musl   *-glibc-* src/functional/fscanf.exe
musl   *-glibc-* src/functional/fwscanf.exe
musl   *-glibc-* src/functional/sscanf.exe
musl   *-glibc-* src/functional/strftime.exe
musl   *-glibc-* src/math/j1.exe
musl   *-glibc-* src/math/j1f.exe
musl   *-glibc-* src/math/jn.exe
musl   *-glibc-* src/math/jnf.exe
musl   *-glibc-* src/math/tgammaf.exe
musl   *-glibc-* src/math/yn.exe
musl   *-glibc-* src/math/ynf.exe
musl   *-glibc-* src/regression/daemon-failure.exe
musl   *-glibc-* src/regression/dn_expand-empty.exe
musl   *-glibc-* src/regression/dn_expand-ptr-0.exe
musl   *-glibc-* src/regression/regex-ere-backref.exe
musl   *-glibc-* src/regression/regex-escaped-high-byte.exe
musl   *-glibc-* src/regression/setvbuf-unget.exe

# and a glibc guest on a musl host runs musl's
glibc  *-musl-* src/functional/strptime.exe
glibc  *-musl-* src/math/frexpl.exe
glibc  *-musl-* src/regression/regex-backref-oob.exe
glibc  *-musl-* src/regression/regexec-backref.exe

# a dynamic guest's malloc is the host's, which still has memory
*      * src/regression/malloc-brk-fail.exe

# fork in a signal handler, flaky on musl hosts
*      *-musl-* src/regression/raise-race.exe flaky
